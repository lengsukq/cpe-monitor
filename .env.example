ADMIN_PASSWORD=change_this_admin_password
JWT_SECRET=change_this_to_a_long_random_secret

# CPE credentials are server-side only. Do not put the real password in source code.
CPE_DEFAULT_URL=http://192.168.31.1
CPE_USERNAME=admin
CPE_PASSWORD=change_this_cpe_password

# Optional SMTP fallback. The settings page can also store a per-account config.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
