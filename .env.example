ADMIN_PASSWORD=change_this_admin_password
JWT_SECRET=change_this_to_a_long_random_secret

# CPE credentials are server-side only. Do not put the real password in source code.
CPE_DEFAULT_URL=http://192.168.31.1
CPE_USERNAME=admin
CPE_PASSWORD=change_this_cpe_password
# Stable secret used to encrypt the reusable CPE SessionID/token in SQLite.
# Falls back to JWT_SECRET when omitted. Do not regenerate it on every restart.
CPE_SESSION_SECRET=change_this_to_another_long_random_secret
# Persisted sessions idle longer than this are discarded and authenticated again.
CPE_SESSION_MAX_IDLE_HOURS=24
# Maximum duration of a single CPE HTTP request before it is aborted.
CPE_REQUEST_TIMEOUT_MS=15000
# Optional dedicated key for encrypting a CPE password saved from the settings UI.
# Falls back to CPE_SESSION_SECRET, then JWT_SECRET.
CPE_CONFIG_SECRET=change_this_to_a_long_stable_config_secret

# Optional SMTP fallback. The settings page can also store a per-account config.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
